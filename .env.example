# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://hoop:hoop@localhost:5432/hoopcouncil

# LLM: openrouter | anthropic | openai | gemini | local | mock
HOOP_LLM_PROVIDER=openrouter
# OpenRouter (https://openrouter.ai/keys): free models first, cheap paid backup from your credit.
OPENROUTER_API_KEY=
# Optional: pin models instead of "openrouter/free", and change the paid backups (comma-separated model ids).
HOOP_OPENROUTER_PLAYER_MODEL=
HOOP_OPENROUTER_COACH_MODEL=
HOOP_OPENROUTER_PLAYER_FALLBACKS=meta-llama/llama-3.1-8b-instruct
HOOP_OPENROUTER_COACH_FALLBACKS=meta-llama/llama-3.3-70b-instruct
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Player agents use the cheap tier, the coach the strong tier. Leave blank for provider defaults (not used by openrouter).
HOOP_PLAYER_MODEL=
HOOP_COACH_PROVIDER=
HOOP_COACH_MODEL=
# Local OpenAI-compatible server (Ollama: http://localhost:11434/v1)
HOOP_LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Optional embeddings for retrieval: none | openai | local  (BM25 is always used)
HOOP_EMBEDDINGS_PROVIDER=none

# Scraping politeness (Sports Reference allows <= 20 requests/minute)
BREF_MIN_INTERVAL_S=3.5

# Frontend -> API
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Hosting (Vercel). Leave blank locally; set these in Vercel > Project > Settings > Environment Variables. ---
# Require a code before anyone can ask a question (protects your OpenRouter credit). Share it with people you trust.
HOOP_ACCESS_CODE=
# Maximum questions per 24 hours across all visitors. Blank = no limit locally, 50 when hosted; 0 = no limit.
HOOP_DAILY_LIMIT=
# Allow requests to name specific models (player_model / coach_model). Default: on locally, off when hosted.
HOOP_ALLOW_MODEL_OVERRIDE=
# Model choices visitors can pick (comma list). Blank = all locally; on Vercel, the providers whose key is set.
HOOP_ALLOWED_PROVIDERS=
# Website domain(s) allowed to call the API directly. Not needed when both run on one Vercel domain.
HOOP_CORS_ORIGINS=http://localhost:3000
